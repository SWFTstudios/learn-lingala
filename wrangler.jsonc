{
  // Cloudflare Workers config: static site + learning app in public/,
  // API Worker in src/ for accounts and progress sync.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learn-lingala",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; everything else is served straight from the edge cache.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn-lingala-db",
      "database_id": "56bd23e6-aee2-4107-86af-d96245f1d200",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Sign-up / sign-in attempts per IP.
    { "name": "AUTH_LIMITER", "namespace_id": "4801", "simple": { "limit": 10, "period": 60 } },
    // All API calls per IP.
    { "name": "API_LIMITER", "namespace_id": "4802", "simple": { "limit": 120, "period": 60 } },
    // Chat messages per signed-in user (each one is a Claude API call).
    { "name": "CHAT_LIMITER", "namespace_id": "4803", "simple": { "limit": 12, "period": 60 } },
    // AI translations per signed-in user.
    { "name": "TRANSLATE_LIMITER", "namespace_id": "4804", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Optional bot protection: create a Turnstile widget, put its site key here,
    // and run `npx wrangler secret put TURNSTILE_SECRET_KEY`.
    "TURNSTILE_SITE_KEY": "",
    // Base URL used in links inside emails and texts (change it if you add a custom domain).
    "APP_URL": "https://learn-lingala.elombe.workers.dev",
    // Email (Cloudflare Email Service): the sender, on a domain onboarded in
    // Compute > Email Service > Email Sending, e.g. "Learn Lingala <hello@yourdomain.com>".
    // Email features stay off while this is empty.
    "EMAIL_FROM": "",
    // Text reminders (Pro): your Twilio number (+15551234567) or Messaging Service SID (MG…).
    // Also run `npx wrangler secret put TWILIO_ACCOUNT_SID` and `TWILIO_AUTH_TOKEN`.
    "TWILIO_FROM": "",
    // Ad banner: Google AdSense publisher ID (ca-pub-…) and ad unit slot ID.
    // Until both are set, the banner space shows the app's own promos.
    "ADSENSE_CLIENT": "",
    "ADSENSE_SLOT": ""
  },
  // Cloudflare Email Service binding for verification, password reset, word of the day and reminders.
  "send_email": [{ "name": "EMAIL" }],
  // Sends word-of-the-day emails and lesson reminders that are due.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Live chat practice needs a Claude API key: `npx wrangler secret put ANTHROPIC_API_KEY`.
  // Chat stays switched off (and the rest of the app works) until it is set.
  "observability": { "enabled": true }
}
